{
  "name": "@ekubo/freelp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run messages:extract --locale en && tsc --noEmit && vite build",
    "check-ts": "tsc --noEmit",
    "lint": "eslint src cli scripts tests",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "messages:extract": "lingui extract --clean",
    "preview": "vite preview --host 127.0.0.1",
    "package": "bun scripts/package-release.ts",
    "notices:check": "bun scripts/notices.ts --check",
    "pack:app": "bun run build && npm pack --ignore-scripts"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "10.0.1",
    "@lingui/babel-plugin-lingui-macro": "6.6.0",
    "@lingui/cli": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@lingui/vite-plugin": "6.6.0",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "@ipld/car": "^5.4.7",
    "@lingui/core": "6.6.0",
    "@lingui/react": "6.6.0",
    "blockstore-core": "^7.0.1",
    "ipfs-unixfs-importer": "^17.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.19"
  },
  "bin": {
    "freelp": "cli/main.ts"
  },
  "files": [
    "dist",
    "cli/main.ts",
    "cli/server.ts",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EkuboProtocol/freelp.git"
  },
  "freelpBundledDependencies": [
    "@ipld/car",
    "@lingui/core",
    "@lingui/react",
    "blockstore-core",
    "ipfs-unixfs-importer",
    "react",
    "react-dom",
    "viem"
  ],
  "engines": {
    "bun": ">=1.4.0"
  }
}
