// The header (title, navigation, account) and footer every page shares.
use Session, TextLink from "./shapes.contract"

component Shell
  props
    page: string
    session: Session
    busy: bool
    connect: action
    disconnect: action
    copy: action
    copied: bool
  view
    header class=Header
      text "FreeLP" role="heading" aria-level=1 class=Title
      nav aria-label="Main navigation" display="flex" flex-wrap="wrap" gap=20 flex=1
        link href="#/positions" aria-current=(page == "positions" ? "page" : "false") class=NavLink border-bottom=(page == "positions" ? "2px solid #111" : "2px solid transparent")
          text "Positions"
        link href="#/networks" aria-current=(page == "networks" ? "page" : "false") class=NavLink border-bottom=(page == "networks" ? "2px solid #111" : "2px solid transparent")
          text "Networks"
      if session.account != ""
        column position="relative"
          button commandfor="account-menu" command="show-modal" aria-label=`Connected wallet: ${session.account}` class=AccountButton
            row gap=8 align-items="center"
              Identicon(cells=session.identicon)
              text session.short font-family="monospace"
          dialog id="account-menu" aria-label="Account" closedby="any" class=Menu testId="account-menu"
            column gap=10
              text session.account font-family="monospace" overflow-wrap="anywhere"
              button press=copy class=Plain
                text (copied ? "Copied" : "Copy address")
              button press=disconnect disabled=busy commandfor="account-menu" command="close" class=Plain
                text "Disconnect wallet"
      else
        row gap=8 flex-wrap="wrap" justify-content="end"
          for w in session.wallets key=w.uuid
            button press=connect(w.uuid) class=Plain
              text `Connect ${w.name}`
          if session.wallets.length == 0
            text "No wallet detected" font-size=13 color="#555"

component Identicon
  props
    cells: number[]
  view
    svg width=22 height=22 viewBox="0 0 7 7" aria-hidden="true"
      rect width=7 height=7 fill="#eee"
      for i in cells key=`${i}`
        rect x=(i % 5 + 1) y=(floor(i / 5) + 1) width=1 height=1 fill="#111"

component Footer
  props
    version: string
  view
    footer class=FooterBar
      row gap=12 align-items="center" flex-wrap="wrap" flex=1
        link href="#/terms" class=TextLink
          text "Terms"
        link href="#/build" class=TextLink
          text "About FreeLP"
        link href="https://github.com/EkuboProtocol/freelp" aria-label="FreeLP on GitHub" title="FreeLP on GitHub" class=TextLink
          svg aria-hidden="true" viewBox="0 0 16 16" width=18 height=18 fill="currentColor"
            path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        text `v${version}` font-size=13 color="#555"
      text "No application fees. Network gas costs apply."

style Header
  display="flex" align-items="center" justify-content="space-between" gap=20 border-bottom="1px solid #111" padding-bottom=22 margin-bottom=22

style Title
  font-size=28 font-weight=700 letter-spacing=-0.8 margin=0

style NavLink
  text-decoration="none" padding="8px 4px" font-weight=500 color="inherit"

style AccountButton
  border="1px solid #666" padding="6px 10px" background-color="#fff"

style Menu
  padding=16 border="1px solid #111" background-color="#fff" min-width=260

style Plain
  border="1px solid #666" padding="8px 12px" background-color="#fff"

style FooterBar
  display="flex" flex-wrap="wrap" gap=12 align-items="center" margin-top=40 border-top="1px solid #bbb" padding-top=16
