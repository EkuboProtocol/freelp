+// Spreading a whole request into String.fromCharCode overflows the stack once
+// it is large (a contract deployment's calldata, say): encode it in chunks.
+function base64(bytes) {
+  let text = '';
+  for (let i = 0; i < bytes.length; i += 16384) text += String.fromCharCode(...bytes.subarray(i, i + 16384));
+  return btoa(text);
+}
